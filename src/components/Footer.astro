---
import { nav, site, visibleSocials } from '../data/site';
import { getProjects } from '../data/projects';
import { url, projectUrl } from '../utils/url';
import Arrow from './Arrow.astro';

interface Props {
  // Nasconde l'invito "vai ad About" quando sei già su About.
  showCta?: boolean;
}
const { showCta = true } = Astro.props;

const projects = await getProjects();
const year = new Date().getFullYear();

// Tre stelline sospese sopra le onde. Tempi diversi per ognuna, così non brillano a tempo.
const stars = [
  { x: '14%', size: '11px', dur: '9s', delay: '-2s', glow: '2.8s' },
  { x: '52%', size: '15px', dur: '11.5s', delay: '-6s', glow: '3.6s' },
  { x: '83%', size: '10px', dur: '10s', delay: '-3.5s', glow: '2.4s' },
];

// Tre onde: dietro più alta, fitta e trasparente; davanti più bassa, larga e piena.
// `visible` = periodi (176 unità ciascuno) visibili a schermo. L'SVG ne contiene il doppio,
// perché lo strato è largo 200% e scorre di metà.
interface Wave {
  name: string;
  base: number; // altezza del ventre dell'onda (su 40)
  amp: number; // altezza della cresta
  visible: number; // periodi visibili a schermo
}
const wavePath = ({ base, amp, visible }: Wave) =>
  `M0 ${base}c30 0 58-${amp} 88-${amp}s58 ${amp} 88 ${amp}` +
  ` 58-${amp} 88-${amp} 58 ${amp} 88 ${amp}`.repeat(visible * 2 - 1) +
  'V40H0z';
const waves: Wave[] = [
  { name: 'back', base: 20, amp: 10, visible: 3 },
  { name: 'mid', base: 26, amp: 8, visible: 2 },
  { name: 'front', base: 32, amp: 6, visible: 2 },
];
---

<div class="footer-wave" aria-hidden="true">
  <!-- Ogni onda è un div largo il doppio del contenitore che scorre del -50% con translate:
       così Safari/iOS la sposta sulla GPU invece di ridisegnare l'SVG. Metà div è
       esattamente un periodo dell'onda, quindi il loop non ha giunture. -->
  {
    waves.map((w) => (
      <div class={`footer-wave__layer footer-wave__layer--${w.name}`}>
        <svg viewBox={`0 0 ${352 * w.visible} 40`} preserveAspectRatio="none">
          <path d={wavePath(w)} />
        </svg>
      </div>
    ))
  }

  {
    stars.map((s) => (
      <span
        class="footer-wave__star"
        style={`--x:${s.x};--size:${s.size};--dur:${s.dur};--delay:${s.delay};--glow-dur:${s.glow}`}
      >
        <svg viewBox="0 0 24 24">
          <path d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0z" />
        </svg>
      </span>
    ))
  }
</div>

<footer class="footer">
  <div class="footer__stars" aria-hidden="true"></div>

  {
    showCta && (
      <div class="footer__top">
        <div class="footer__headline">
          <div class="orb footer__orb" aria-hidden="true" />
          <h2>Want to see hobbies and side projects?</h2>
        </div>
        <a class="button" href={url('about/')}>
          Go to About <Arrow />
        </a>
      </div>
    )
  }

  <div class="footer__grid">
    <div class="footer__col">
      <h2>Navigate</h2>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.path)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="footer__col">
      <h2>Projects</h2>
      <ul>
        {
          projects.map((p) => (
            <li>
              <a href={projectUrl(p.id)} translate="no">{p.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
    {
      visibleSocials.length > 0 && (
        <div class="footer__col">
          <h2>Elsewhere</h2>
          <ul>
            {visibleSocials.map((s) => (
              <li>
                <a href={s.href} rel="me noopener" target="_blank">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="footer__col">
      <h2>Contact</h2>
      <ul>
        <li><a href={`mailto:${site.email}`} translate="no">{site.email}</a></li>
        {
          site.cv && (
            <li>
              <a href={url(site.cv)} download>
                Download CV
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <span>&copy; {year} <span translate="no">{site.name}</span></span>
    <a href={url('privacy/')}>Privacy</a>
    <a href={url('cookies/')}>Cookie Policy</a>
    <p class="moon-phase" id="moonPhase" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle class="moon-phase__dark" cx="12" cy="12" r="10"></circle>
        <path class="moon-phase__lit" d=""></path>
      </svg>
      <span></span>
    </p>
  </div>
</footer>

<script>
  import { initMoonPhase } from '../scripts/moon-phase';
  import { initFooterWave } from '../scripts/footer-wave';
  initMoonPhase();
  initFooterWave();
</script>
