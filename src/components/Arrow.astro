---
// Freccia SVG usata nei link e nei bottoni (direzione: right | left).
interface Props {
  direction?: 'right' | 'left';
}
const { direction = 'right' } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style={direction === 'left' ? 'transform: scaleX(-1)' : undefined}
>
  <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path>
</svg>
