---
import { getCoverUrl, type Project } from '../data/projects';
import { projectUrl } from '../utils/url';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, category, year, coverSize, coverPosition } = project.data;

// La copertina è uno sfondo CSS (vedi getCoverUrl): la passiamo come variabile.
const style = `--cover:url("${await getCoverUrl(project)}");--cover-size:${coverSize};--cover-position:${coverPosition}`;
---

<a class="card" href={projectUrl(project.id)} style={style}>
  <div class="card__art" aria-hidden="true"></div>
  <div class="card__moon" aria-hidden="true"></div>
  <div class="card__body">
    <Heading class="card__title">{title}</Heading>
    <p class="card__meta">{category} &middot; {year}</p>
  </div>
</a>
