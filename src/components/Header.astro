---
import { Image } from 'astro:assets';
import logo from '../assets/img/sun-moon-mark.png';
import { nav, site } from '../data/site';
import { url, isActive } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname;
---

<header>
  {/* translate="no": se il browser traduce la pagina, il menu resta in inglese (Home, Projects,
      About si capiscono comunque) e non va a capo con le traduzioni più lunghe. */}
  <nav class="nav" id="siteNav" aria-label="Main navigation" translate="no">
    <a class="nav__mark" href={url()}>
      <Image class="nav__logo" src={logo} alt="" width={56} height={56} loading="eager" />
      <span class="nav__name">{site.name}</span>
      <span class="visually-hidden">— Home</span>
    </a>
    <div class="nav__right">
      <ul class="nav__links">
        {
          nav.map((item) => {
            const active = isActive(current, item.path);
            return (
              <li>
                <a href={url(item.path)} aria-current={active ? 'page' : undefined}>
                  {item.label}
                  {/* Un solo puntino per pagina: cambiando pagina scivola sotto la nuova voce (base.css). */}
                  {active && <span class="nav__dot" aria-hidden="true" />}
                </a>
              </li>
            );
          })
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
</script>
