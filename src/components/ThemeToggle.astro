---
// Interruttore notte/giorno. Lo stato iniziale lo decide lo script inline nel <head>
// (BaseLayout), qui si aggiorna solo aria-pressed e si gestisce il click.
---

<button class="theme-toggle" id="themeToggle" type="button" aria-label="Daylight theme" aria-pressed="false">
  <span class="theme-toggle__track">
    <span class="theme-toggle__thumb">
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.6" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path
            d="M12 2.5v2.4M12 19.1v2.4M21.5 12h-2.4M4.9 12H2.5M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7M18.4 18.4l-1.7-1.7M7.3 7.3 5.6 5.6"
          ></path>
        </g>
      </svg>
    </span>
  </span>
</button>

<script>
  import { initThemeToggle } from '../scripts/theme';
  initThemeToggle();
</script>
