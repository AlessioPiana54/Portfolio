---
// Gatto e lampione nella pagina About (generato da uno script: i keyframe di falena, testa,
// farfalla e le pose della coda sono calcolati, non scritti a mano).
// Notte (tema luna): il lampione è acceso e un gatto nero dipinto caccia una falena che non prende.
// Giorno (tema sole): il lampione è spento e il gatto dorme; ogni tanto una farfalla gli si posa
// sull'orecchio. Animazioni CSS su transform/opacity; la forma della coda è interpolata dall'SVG
// (<animate>). Il pulsante pausa ferma tutto (scripts/lamp-cat.ts); fuori schermo si ferma da sola.
---

<figure class="lamp-cat" id="lampCat">
  <!-- Descrizione per gli screen reader. Non è un <title> SVG: il browser lo mostrerebbe
       come tooltip passandoci sopra col mouse. -->
  <span class="visually-hidden" id="lampCatTitle">
    A black cat beside a street lamp: at night it hunts a moth under the light and always misses,
    by day it sleeps curled up at the foot of the lamp while a butterfly lands on its ear.
  </span>
  <button class="lamp-cat__pet" type="button" aria-label="Pet the cat" aria-describedby="lampCatTitle">
  <svg viewBox="0 0 480 600" aria-hidden="true">
    <defs>
      <radialGradient id="lcGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#ffd59a" stop-opacity="0.75"></stop>
        <stop offset="0.45" stop-color="#ffd59a" stop-opacity="0.22"></stop>
        <stop offset="1" stop-color="#ffd59a" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="lcCone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffd59a" stop-opacity="0.32"></stop>
        <stop offset="1" stop-color="#ffd59a" stop-opacity="0.06"></stop>
      </linearGradient>
      <radialGradient id="lcPool" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#ffd59a" stop-opacity="0.45"></stop>
        <stop offset="1" stop-color="#ffd59a" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="lcLit" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff6e2"></stop>
        <stop offset="1" stop-color="#ffc977"></stop>
      </linearGradient>
      <radialGradient id="lcSun" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#ffd166" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#ffd166" stop-opacity="0"></stop>
      </radialGradient>

      <!-- Pelo nero: il lato verso la luce (in alto a destra) è più caldo e chiaro. -->
      <radialGradient id="lcFur" cx="0.74" cy="0.26" r="0.95">
        <stop offset="0" stop-color="#43374b"></stop>
        <stop offset="0.38" stop-color="#261f35"></stop>
        <stop offset="1" stop-color="#110e1a"></stop>
      </radialGradient>
      <!-- Il gatto sveglio usa una sfumatura sola, nelle sue coordinate: le parti non hanno
           ciascuna il proprio centro di luce, quindi coscia e zampe non si staccano come dischi. -->
      <radialGradient id="lcFurCat" gradientUnits="userSpaceOnUse" cx="34" cy="-150" r="210">
        <stop offset="0" stop-color="#43374b"></stop>
        <stop offset="0.4" stop-color="#261f35"></stop>
        <stop offset="1" stop-color="#110e1a"></stop>
      </radialGradient>
      <linearGradient id="lcHaunchLight" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#55465f" stop-opacity="0.85"></stop>
        <stop offset="1" stop-color="#55465f" stop-opacity="0"></stop>
      </linearGradient>
      <radialGradient id="lcFurSoft" cx="0.7" cy="0.2" r="1">
        <stop offset="0" stop-color="#352c42"></stop>
        <stop offset="1" stop-color="#15121f"></stop>
      </radialGradient>
      <!-- Bordo di luce: freddo a sinistra, niente al centro, caldo verso il lampione. -->
      <linearGradient id="lcRim" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#a8b4ff" stop-opacity="0.38"></stop>
        <stop offset="0.38" stop-color="#a8b4ff" stop-opacity="0"></stop>
        <stop offset="0.66" stop-color="#ffd59a" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#ffd59a" stop-opacity="0.75"></stop>
      </linearGradient>
      <!-- luce sul muscolo della coscia: dà volume senza disegnare un contorno -->
      <radialGradient id="lcHaunch" cx="0.68" cy="0.22" r="0.8">
        <stop offset="0" stop-color="#4d3f57" stop-opacity="0.9"></stop>
        <stop offset="0.55" stop-color="#2a2238" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#1a1526" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="lcIris" cx="0.45" cy="0.4" r="0.6">
        <stop offset="0" stop-color="#ffe9a6"></stop>
        <stop offset="0.6" stop-color="#e3a634"></stop>
        <stop offset="1" stop-color="#8a5414"></stop>
      </radialGradient>
      <radialGradient id="lcShadow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#05040b" stop-opacity="0.6"></stop>
        <stop offset="1" stop-color="#05040b" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <!-- ===== Sfondo che cambia col tema ===== -->
    <g class="lc-night">
      <g class="lc-stars">
        <circle cx="70" cy="90" r="2.5"></circle>
        <circle cx="150" cy="40" r="2"></circle>
        <circle cx="420" cy="70" r="2.5"></circle>
        <circle cx="440" cy="220" r="2"></circle>
        <circle cx="40" cy="250" r="2"></circle>
        <path d="M110 150 q2 8 10 10 q-8 2 -10 10 q-2 -8 -10 -10 q8 -2 10 -10 Z"></path>
        <path d="M400 140 q1.5 6 7 7 q-5.5 1.5 -7 7 q-1.5 -5.5 -7 -7 q5.5 -1 7 -7 Z"></path>
      </g>
      <g class="lc-flicker">
        <circle class="lc-glow" cx="300" cy="166" r="150" fill="url(#lcGlow)"></circle>
        <path d="M282 196 L318 196 L438 548 L162 548 Z" fill="url(#lcCone)"></path>
      </g>
    </g>
    <g class="lc-day">
      <circle cx="380" cy="110" r="120" fill="url(#lcSun)"></circle>
      <path
        class="lc-cloud"
        d="M60 120 q6 -22 30 -16 q12 -22 38 -8 q24 -4 26 18 q16 4 10 16 h-104 q-10 -4 0 -10 z"
      ></path>
    </g>

    <!-- ===== Terreno e lampione (comuni) ===== -->
    <ellipse class="lc-ground" cx="250" cy="548" rx="230" ry="26"></ellipse>
    <g class="lc-night">
      <ellipse class="lc-flicker" cx="300" cy="546" rx="150" ry="20" fill="url(#lcPool)"></ellipse>
    </g>

    <g class="lc-lamp">
      <path d="M274 548 L283 516 H317 L326 548 Z"></path>
      <rect x="293" y="200" width="14" height="320" rx="3"></rect>
      <rect x="284" y="194" width="32" height="10" rx="3"></rect>
      <path class="lc-glass" d="M274 136 H326 L318 196 H282 Z"></path>
      <g class="lc-night">
        <path class="lc-flicker" d="M274 136 H326 L318 196 H282 Z" fill="url(#lcLit)"></path>
      </g>
      <path d="M300 136 V196 M278 166 H322" class="lc-frame"></path>
      <path d="M262 138 L300 106 L338 138 Z"></path>
      <circle cx="300" cy="100" r="6"></circle>
    </g>

    <!-- ===== Notte: il gatto caccia la falena ===== -->
    <g class="lc-night">
      <g transform="translate(215 548)">
        <!-- ombra a terra: si stringe e schiarisce quando il gatto è in aria -->
        <ellipse class="cat__shadow" cx="-14" cy="0" rx="66" ry="7" fill="url(#lcShadow)"></ellipse>
        <g class="cat">
          <g class="cat__body">
            <!-- coda: una sola forma che si assottiglia; l'SVG la fa passare tra tre pose -->
