              ></path>
            </g>
            <!-- coscia: stesso pelo del busto (sfumatura continua), il volume lo dà una luce a mezzaluna -->
            <g class="cat__thigh">
              <path class="fur-cat" d="M-60 -28 C-62 -52 -46 -68 -26 -64 C-10 -60 -6 -42 -10 -26 C-14 -12 -24 -5 -36 -5 C-50 -5 -58 -14 -60 -28 Z"></path>
