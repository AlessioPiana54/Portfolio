                values="M-51.1 -15.4 L-56.0 -14.3 L-60.9 -13.5 L-65.6 -12.8 L-70.2 -12.4 L-74.8 -12.2 L-79.1 -12.1 L-83.4 -12.3 L-87.4 -12.7 L-91.2 -13.3 L-94.9 -14.0 L-98.3 -15.0 L-101.4 -16.2 L-104.3 -17.7 L-106.9 -19.3 L-109.3 -21.1 L-111.4 -23.2 L-113.2 -25.5 L-114.7 -28.1 L-116.0 -31.0 L-116.8 -34.3 L-117.4 -37.9 L-117.5 -42.0 Q-120.0 -44.5 -122.5 -42.0 L-122.7 -37.7 L-122.5 -33.4 L-121.8 -29.4 L-120.7 -25.6 L-119.1 -22.0 L-117.1 -18.8 L-114.7 -15.7 L-111.9 -13.0 L-108.8 -10.5 L-105.4 -8.4 L-101.7 -6.5 L-97.8 -4.8 L-93.6 -3.4 L-89.3 -2.3 L-84.7 -1.4 L-80.0 -0.7 L-75.1 -0.2 L-70.0 0.0 L-64.9 0.1 L-59.6 0.0 L-54.3 -0.2 L-48.9 -0.6 Z;M-51.2 -15.4 L-56.4 -14.1 L-61.4 -13.2 L-66.3 -12.7 L-71.2 -12.5 L-76.0 -12.6 L-80.6 -13.0 L-85.1 -13.6 L-89.3 -14.6 L-93.3 -15.7 L-97.0 -17.1 L-100.3 -18.7 L-103.4 -20.5 L-106.0 -22.5 L-108.3 -24.6 L-110.2 -26.9 L-111.6 -29.4 L-112.6 -32.0 L-113.2 -34.9 L-113.2 -38.0 L-112.8 -41.3 L-111.6 -44.9 L-109.8 -48.8 Q-110.8 -52.2 -114.2 -51.2 L-116.6 -47.1 L-118.3 -42.9 L-119.3 -38.7 L-119.7 -34.6 L-119.3 -30.6 L-118.3 -26.7 L-116.7 -23.0 L-114.5 -19.6 L-111.9 -16.4 L-108.7 -13.5 L-105.2 -10.8 L-101.2 -8.4 L-97.0 -6.3 L-92.4 -4.5 L-87.6 -2.9 L-82.5 -1.7 L-77.2 -0.7 L-71.7 -0.1 L-66.1 0.2 L-60.3 0.2 L-54.5 -0.1 L-48.8 -0.6 Z;M-51.1 -15.4 L-56.0 -14.3 L-60.9 -13.5 L-65.6 -12.8 L-70.2 -12.4 L-74.8 -12.2 L-79.1 -12.1 L-83.4 -12.3 L-87.4 -12.7 L-91.2 -13.3 L-94.9 -14.0 L-98.3 -15.0 L-101.4 -16.2 L-104.3 -17.7 L-106.9 -19.3 L-109.3 -21.1 L-111.4 -23.2 L-113.2 -25.5 L-114.7 -28.1 L-116.0 -31.0 L-116.8 -34.3 L-117.4 -37.9 L-117.5 -42.0 Q-120.0 -44.5 -122.5 -42.0 L-122.7 -37.7 L-122.5 -33.4 L-121.8 -29.4 L-120.7 -25.6 L-119.1 -22.0 L-117.1 -18.8 L-114.7 -15.7 L-111.9 -13.0 L-108.8 -10.5 L-105.4 -8.4 L-101.7 -6.5 L-97.8 -4.8 L-93.6 -3.4 L-89.3 -2.3 L-84.7 -1.4 L-80.0 -0.7 L-75.1 -0.2 L-70.0 0.0 L-64.9 0.1 L-59.6 0.0 L-54.3 -0.2 L-48.9 -0.6 Z;M-50.8 -15.5 L-55.6 -14.5 L-60.4 -13.8 L-65.2 -13.1 L-70.0 -12.5 L-74.7 -12.1 L-79.4 -11.8 L-84.0 -11.5 L-88.6 -11.5 L-93.0 -11.5 L-97.3 -11.7 L-101.5 -12.1 L-105.6 -12.6 L-109.5 -13.3 L-113.2 -14.2 L-116.8 -15.3 L-120.1 -16.6 L-123.3 -18.1 L-126.2 -19.8 L-129.0 -21.8 L-131.5 -24.0 L-133.8 -26.5 L-135.9 -29.4 Q-139.4 -30.1 -140.1 -26.6 L-138.1 -23.3 L-135.7 -20.1 L-133.0 -17.2 L-130.1 -14.6 L-126.8 -12.2 L-123.3 -10.1 L-119.6 -8.2 L-115.7 -6.6 L-111.6 -5.1 L-107.4 -3.9 L-103.0 -2.9 L-98.4 -2.1 L-93.8 -1.4 L-89.1 -0.9 L-84.2 -0.5 L-79.3 -0.3 L-74.4 -0.2 L-69.4 -0.1 L-64.3 -0.2 L-59.3 -0.3 L-54.2 -0.4 L-49.2 -0.5 Z;M-51.1 -15.4 L-56.0 -14.3 L-60.9 -13.5 L-65.6 -12.8 L-70.2 -12.4 L-74.8 -12.2 L-79.1 -12.1 L-83.4 -12.3 L-87.4 -12.7 L-91.2 -13.3 L-94.9 -14.0 L-98.3 -15.0 L-101.4 -16.2 L-104.3 -17.7 L-106.9 -19.3 L-109.3 -21.1 L-111.4 -23.2 L-113.2 -25.5 L-114.7 -28.1 L-116.0 -31.0 L-116.8 -34.3 L-117.4 -37.9 L-117.5 -42.0 Q-120.0 -44.5 -122.5 -42.0 L-122.7 -37.7 L-122.5 -33.4 L-121.8 -29.4 L-120.7 -25.6 L-119.1 -22.0 L-117.1 -18.8 L-114.7 -15.7 L-111.9 -13.0 L-108.8 -10.5 L-105.4 -8.4 L-101.7 -6.5 L-97.8 -4.8 L-93.6 -3.4 L-89.3 -2.3 L-84.7 -1.4 L-80.0 -0.7 L-75.1 -0.2 L-70.0 0.0 L-64.9 0.1 L-59.6 0.0 L-54.3 -0.2 L-48.9 -0.6 Z"></animate>
            </path>
            <!-- zampa anteriore lontana: dietro il busto, in aria penzola sotto la pancia -->
            <g class="cat__far">
              <path
                class="fur-cat cat__sep cat__shade"
                d="M2 -82 C0 -58 1 -32 1 -12 C1 -4 3 0 8 0 L18 0 C22 0 23 -4 19 -7 C15 -9 14 -12 14 -16 C14 -36 14 -60 15 -82 Z"
              ></path>
            </g>
            <!-- busto: anca piena dietro, schiena che sale, pancia appena arrotondata -->
            <path
              class="fur-cat cat__sep"
              d="M38 -72 C36 -54 35 -36 34 -22 C32 -6 22 4 8 6 C-6 8 -18 8 -30 5 C-48 1 -60 -9 -65 -26 C-68 -36 -67 -46 -64 -54 C-58 -82 -38 -104 -12 -118 C-2 -124 6 -128 12 -128 C22 -128 30 -120 34 -108 C38 -96 40 -84 38 -72 Z"
            ></path>
