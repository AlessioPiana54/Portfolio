              <path class="cat__whisker" d="M-2 -132 L-24 -136 M-2 -128 L-24 -126 M42 -132 L64 -136 M42 -128 L64 -126"></path>
            </g>
          </g>
        </g>
      </g>

      <g transform="translate(300 166)">
        <g class="moth">
          <g class="moth__wings">
            <ellipse cx="-7" cy="0" rx="8" ry="5.5"></ellipse>
