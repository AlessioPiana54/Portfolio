<style>
  .lamp-cat {
    position: relative;
    margin: 0;
    width: 100%;
  }

  .lamp-cat__pet {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    touch-action: manipulation;
  }

  .lamp-cat__pet > svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---------- Pulsante pausa: stesso disegno dei pulsanti del carosello ---------- */
  .lamp-cat__pause {
    position: absolute;
    right: 2%;
    bottom: 1%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    color: var(--text);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.16s var(--ease-out);
  }
  /* area di tocco di 48px senza ingrandire il disegno */
  .lamp-cat__pause::after {
    content: '';
    position: absolute;
    inset: -4px;
  }
  .lamp-cat__pause:active {
    transform: scale(0.92);
  }
  @media (hover: hover) and (pointer: fine) {
    .lamp-cat__pause:hover {
      background: var(--accent);
      color: var(--accent-ink);
      border-color: transparent;
    }
  }
  .lamp-cat__icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .lamp-cat__icon--play,
  .lamp-cat.is-user-paused .lamp-cat__icon--pause {
    display: none;
  }
  .lamp-cat.is-user-paused .lamp-cat__icon--play {
    display: block;
  }

  /* Il fumetto: posizionato dallo script sopra la testa del gatto, ovunque sia in quel momento. */
  .lamp-cat__bubble {
    position: absolute;
    left: var(--x, 50%);
    top: var(--y, 50%);
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-full);
    background: #fff3d6;
    color: #1b1b3a;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    translate: -50% -100%;
    transform-origin: 50% 100%;
  }

  .lamp-cat__bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -5px;
    width: 10px;
    height: 10px;
    background: inherit;
    border-radius: 2px;
    transform: translateX(-50%) rotate(45deg);
  }

  :global(html[data-theme='light']) .lamp-cat__bubble {
    background: #2b2450;
    color: #fbf3e6;
  }

  /* ---------- Colori della scena ---------- */
  .lc-lamp {
    fill: #2e2a5c;
  }
  .lc-lamp .lc-glass {
    fill: #e9dfcd;
  }
  .lc-frame {
    fill: none;
    stroke: #2e2a5c;
    stroke-width: 3;
  }
  .lc-ground {
    fill: var(--bg-raised);
    transition: fill var(--theme-duration) ease;
  }
  .lc-stars {
    fill: #fff3d6;
  }
  .lc-cloud {
    fill: #fff;
    opacity: 0.9;
  }

  /* ---------- Il gatto dipinto ---------- */
  .fur {
    fill: url(#lcFur);
  }
  .fur-soft {
    fill: url(#lcFurSoft);
  }
  .fur-cat {
    fill: url(#lcFurCat);
  }
  /* le parti lontane (orecchio, zampe dietro) un filo più in ombra */
  .cat__shade {
    filter: brightness(0.82);
  }
  .cat__haunch-light {
    fill: url(#lcHaunchLight);
    opacity: 0.45;
  }
  .cat__outline {
    fill: none;
    stroke: #3e3450;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  /* bordo di luce sul contorno: caldo verso il lampione, freddo dall'altra parte */
  .rim {
    stroke: url(#lcRim);
    stroke-width: 1.7;
    stroke-linejoin: round;
  }
  .rim--soft {
    stroke-width: 1.2;
    stroke-opacity: 0.55;
  }
  .cat__haunch {
    fill: url(#lcHaunch);
  }
  .cat__tail {
    stroke: none;
  }
  .cat__ear-in {
    fill: #5a3443;
    opacity: 0.85;
  }
  .cat__ear-hair {
    fill: none;
    stroke: #e8d6c4;
    stroke-opacity: 0.45;
    stroke-width: 0.9;
    stroke-linecap: round;
  }
  .cat__eye {
    fill: url(#lcIris);
  }
  .cat__pupil {
    fill: #0b0910;
  }
  .cat__catch {
    fill: #fff8e8;
  }
  .cat__nose {
    fill: #6e3c4a;
  }
  .cat__mouth {
    fill: none;
    stroke: #f4d9a0;
    stroke-opacity: 0.4;
    stroke-width: 1;
    stroke-linecap: round;
  }
  .cat__whisker {
    fill: none;
    stroke: #f4ead8;
    stroke-opacity: 0.5;
    stroke-width: 0.9;
    stroke-linecap: round;
  }
  /* testa e zampine del gatto che dorme si staccano dal corpo con un filo di pelo più chiaro */
  .sleeper__sep,
  .cat__sep {
    stroke: #3e3450;
    stroke-width: 1.6;
  }
  .sleeper__tail {
    fill: none;
    stroke: #1c1828;
    stroke-width: 13;
    stroke-linecap: round;
  }
  .sleeper__tail--tip {
    stroke-width: 10;
  }
  .sleeper__eye {
    fill: none;
    stroke: #f4d9a0;
    stroke-opacity: 0.55;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .moth__wings {
    fill: #fde3b0;
    opacity: 0.9;
  }
  .moth__body {
    fill: #f2a65a;
  }
  .zzz {
    font-family: var(--font-mono);
    font-weight: 700;
    fill: var(--pink);
    transition: opacity 0.2s ease;
  }
  /* Mentre il gatto "parla" le z si fanno da parte. */
  .lamp-cat.is-talking .zzz {
    opacity: 0;
  }
  .zzz text:nth-child(1) {
    font-size: 26px;
  }
  .zzz text:nth-child(2) {
    font-size: 32px;
  }
  .zzz text:nth-child(3) {
    font-size: 38px;
  }
  .butterfly__wing {
    fill: #f2a6b0;
  }
  .butterfly__body {
    fill: #2e2a5c;
  }

  /* ---------- Notte / giorno ---------- */
  .lc-night,
  .lc-day {
    transition: opacity var(--theme-duration) ease;
  }
  .lc-day {
    opacity: 0;
  }
  :global(html[data-theme='light']) .lc-day {
    opacity: 1;
  }
  :global(html[data-theme='light']) .lc-night {
    opacity: 0;
  }

  /* La scena nascosta non consuma frame; il pulsante pausa e lo scroll fermano tutto. */
  :global(html:not([data-theme='light'])) .lc-day *,
  :global(html[data-theme='light']) .lc-night *,
  .lamp-cat.is-paused *,
  .lamp-cat.is-user-paused * {
    animation-play-state: paused !important;
  }

  /* ---------- Origini delle trasformazioni ---------- */
  /* Le parti del gatto ruotano su perni anatomici, scritti nelle coordinate del gatto. */
  .cat,
  .cat__body,
  .cat__shadow,
  .cat__head,
  .cat__paw,
  .cat__forearm,
  .cat__far,
  .cat__thigh,
  .cat__foot {
    transform-box: view-box;
  }
  .cat__eyes,
  .cat__pupil,
  .moth__wings,
  .lc-glow,
  .sleeper,
  .sleeper__tip,
  .sleeper__ear,
  .zzz text,
  .butterfly__wing,
  .lc-stars > * {
    transform-box: fill-box;
  }

  /* ---------- NOTTE: ciclo di caccia di 10 s, condiviso da gatto, ombra e falena ----------
     0-3 s osserva · 3-3.8 s si acquatta · 3.8-4.3 s dondola · 4.3-4.8 s balzo · 4.8-5.05 s sospeso
     5.05-5.45 s caduta · 5.45-5.9 s atterraggio · 6-8.5 s toeletta · poi torna a osservare */
  .cat {
    transform-origin: -14px 0;
    animation: cat-jump 10s infinite;
  }
  .cat__body {
    transform-origin: -14px 0;
    animation: cat-squash 10s infinite;
  }
  .cat__shadow {
    transform-origin: -14px 0;
    animation: cat-shadow 10s infinite;
  }
  .cat__paw {
    transform-origin: 22px -80px;
    animation: cat-paw 10s infinite;
  }
  .cat__forearm {
    transform-origin: 22px -42px;
    animation: cat-forearm 10s infinite;
  }
  .cat__far {
    transform-origin: 8px -80px;
    animation: far-leg 10s infinite;
  }
  .cat__thigh {
    transform-origin: -34px -56px;
    animation: hind-thigh 10s infinite;
  }
  .cat__foot {
    transform-origin: -37px -34px;
    animation: hind-foot 10s infinite;
  }
  /* la testa ha un ciclo di 20 s: due cacce, e nella prima alza lo sguardo al lampione */
  .cat__head {
    transform-origin: 20px -118px;
    animation: cat-look 20s ease-in-out infinite;
  }
  .cat__eyes {
    transform-origin: 50% 50%;
    animation: blink 5.3s infinite;
  }
  .cat__pupil {
    transform-origin: 50% 50%;
    animation: pupil 10s infinite;
  }
  .moth {
    animation: moth-fly 10s linear infinite;
  }
  .moth__wings {
    transform-origin: 50% 50%;
    animation: flap 0.16s ease-in-out infinite alternate;
  }
  .lc-glow {
    transform-origin: 50% 50%;
    animation: glow 3.2s ease-in-out infinite alternate;
  }
  /* il lampione trema per un istante ogni 20 s, mentre il gatto alza la testa */
  .lc-flicker {
    animation: flicker 20s linear infinite;
  }
  .lc-stars > * {
    transform-origin: 50% 50%;
    animation: twinkle 2.8s ease-in-out infinite alternate;
  }
  .lc-stars > :nth-child(2n) {
    animation-delay: -1.4s;
  }
  .lc-stars > :nth-child(3n) {
    animation-duration: 3.6s;
  }

  @keyframes cat-jump {
    0%,
    43% {
      transform: translate(0, 0) rotate(0);
      animation-timing-function: cubic-bezier(0.2, 0.75, 0.35, 1); /* spinta che si smorza */
    }
    48% {
      transform: translate(8px, -100px) rotate(5deg);
      animation-timing-function: ease-in-out;
    }
    50.5% {
      transform: translate(10px, -104px) rotate(2deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.85, 0.45); /* gravità */
    }
    54.5% {
      transform: translate(2px, 0) rotate(-2deg);
      animation-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
    }
    59%,
    100% {
      transform: translate(0, 0) rotate(0);
    }
  }

  @keyframes cat-squash {
    0%,
    30% {
      transform: translateX(0) scale(1, 1);
      animation-timing-function: ease-in-out;
    }
    38% {
      transform: translateX(0) scale(1.06, 0.88);
      animation-timing-function: ease-in-out;
    }
    /* il sedere che dondola prima del salto: tre oscillazioni da 160 ms */
    39.6% {
      transform: translateX(-3px) scale(1.06, 0.88);
      animation-timing-function: ease-in-out;
    }
    41.2% {
      transform: translateX(3px) scale(1.06, 0.88);
      animation-timing-function: ease-in-out;
    }
    43% {
      transform: translateX(0) scale(1.08, 0.86);
      animation-timing-function: cubic-bezier(0.2, 0.75, 0.35, 1);
    }
    46% {
      transform: translateX(0) scale(0.95, 1.07);
      animation-timing-function: ease-in-out;
    }
    50.5% {
      transform: translateX(0) scale(0.98, 1.03);
      animation-timing-function: ease-in;
    }
    54.5% {
      transform: translateX(0) scale(1.1, 0.87);
      animation-timing-function: linear;
    }
    55.7% {
      transform: translateX(0) scale(1.1, 0.87);
      animation-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
    }
    59.2%,
    100% {
      transform: translateX(0) scale(1, 1);
    }
  }

  @keyframes cat-shadow {
    0%,
    30% {
      opacity: 1;
      transform: scale(1, 1);
      animation-timing-function: ease-in-out;
    }
    43% {
      opacity: 1;
      transform: scale(1.1, 1);
      animation-timing-function: cubic-bezier(0.2, 0.75, 0.35, 1);
    }
    48% {
      opacity: 0.4;
      transform: scale(0.62, 0.8);
      animation-timing-function: ease-in-out;
    }
    50.5% {
      opacity: 0.38;
      transform: scale(0.6, 0.8);
      animation-timing-function: cubic-bezier(0.5, 0, 0.85, 0.45);
    }
    54.5% {
      opacity: 1;
      transform: scale(1.14, 1);
      animation-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
    }
    59.2%,
    100% {
      opacity: 1;
      transform: scale(1, 1);
    }
  }

  /* Zampata verso la falena (che è già scappata); per la toeletta il braccio si alza appena
     e l'avambraccio si piega sul gomito, portando la zampa sotto il muso. */
  @keyframes cat-paw {
    0%,
    43% {
      transform: rotate(0);
      animation-timing-function: cubic-bezier(0.2, 0.75, 0.35, 1);
    }
    48% {
      transform: rotate(-150deg);
      animation-timing-function: ease-in-out;
    }
    50.5% {
      transform: rotate(-130deg);
      animation-timing-function: ease-in-out;
