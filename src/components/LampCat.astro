          </g>
          <ellipse class="moth__body" cx="0" cy="0" rx="2" ry="5"></ellipse>
        </g>
      </g>
    </g>

    <!-- ===== Giorno: il gatto dorme ===== -->
    <g class="lc-day">
      <g transform="translate(196 548)">
        <ellipse cx="2" cy="1" rx="96" ry="8" fill="url(#lcShadow)" opacity="0.55"></ellipse>
        <g class="sleeper">
          <!-- corpo acciambellato: anca alta a destra, spalle basse verso la testa -->
          <path
            class="fur rim"
            d="M-64 0 C-94 0 -100 -38 -76 -56 C-50 -78 20 -88 54 -68 C86 -50 90 -14 72 0 Z"
          ></path>
          <!-- coscia con lo zampino posteriore raccolto in avanti -->
