          <g class="sleeper__tip">
            <path class="sleeper__tail sleeper__tail--tip" d="M-24 6 C-36 5 -44 3 -50 0"></path>
          </g>
          <g class="sleeper__head">
            <path class="fur-soft" d="M-100 -44 C-104 -62 -102 -78 -97 -88 C-88 -84 -80 -74 -76 -60 Z"></path>
            <g class="sleeper__ear">
              <path class="fur rim" d="M-40 -44 C-36 -62 -38 -78 -43 -88 C-52 -84 -60 -74 -64 -60 Z"></path>
              <path class="cat__ear-in" d="M-45 -56 C-43 -66 -44 -74 -46 -80 C-51 -76 -55 -70 -57 -62 Z"></path>
            </g>
            <path
              class="fur rim sleeper__sep"
