            </g>
            <!-- zampa anteriore vicina, in due pezzi: il gomito si piega per portarla al muso -->
            <g class="cat__paw">
              <!-- braccio: il contorno è aperto sotto, così al gomito non resta una riga -->
              <path class="fur-cat" d="M16 -84 C14 -70 14 -54 15 -42 C15.5 -35 28.5 -35 28.5 -42 C28.5 -56 28.5 -70 29 -84 Z"></path>
              <path class="cat__outline" d="M16 -84 C14 -70 14 -54 15 -42 M28.5 -42 C28.5 -56 28.5 -70 29 -84"></path>
              <!-- avambraccio sopra il braccio: piegato, passa davanti per arrivare al muso -->
              <g class="cat__forearm">
                <path
                  class="fur-cat"
                  d="M15.5 -44 C15.5 -49 28.5 -49 28.5 -44 C28 -30 28 -20 28 -16 C28 -12 29 -9 33 -7 C37 -4 36 0 32 0 L22 0 C17 0 15 -4 15 -12 C15 -24 15.5 -36 15.5 -44 Z"
