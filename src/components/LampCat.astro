                ></path>
              </g>
            </g>
            <g class="cat__head">
              <!-- stessa testa del gatto che dorme (rotonda, simmetrica attorno a x=20), con gli occhi aperti -->
              <path class="fur-cat cat__shade" d="M-10 -149 C-14 -167 -12 -183 -7 -193 C2 -189 10 -179 14 -165 Z"></path>
              <path class="cat__ear-in" d="M-5 -161 C-7 -171 -6 -179 -4 -185 C1 -181 5 -175 7 -167 Z"></path>
