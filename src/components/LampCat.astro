            class="cat__haunch"
            d="M24 -34 C22 -54 40 -66 58 -60 C76 -54 80 -32 70 -16 C64 -8 56 -4 46 -4 L14 -4 C6 -4 4 -12 12 -14 C18 -16 24 -22 24 -34 Z"
