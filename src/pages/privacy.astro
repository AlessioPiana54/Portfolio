---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Privacy"
  description="Privacy information for this static portfolio: no cookies, no tracking, no analytics."
>
  <section class="page-header">
    <h1 class="page-header__title">Privacy</h1>
  </section>

  <section class="privacy prose">
    <p>
      This site is static: it doesn't use cookies, tracking or analytics tools, and it doesn't collect
      personal data through forms.
    </p>
    <p>
      The only thing stored on your device is your theme choice (day or night), saved in your browser's
      local storage so the site remembers it. It never leaves your browser.
    </p>
    <p>
      GitHub Pages, the hosting service for this site, may log visitors' IP addresses as part of its
      standard access logs. See
      <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener">GitHub's Privacy Statement</a>
      for details.
    </p>
    <p>
      For any request regarding personal data, write to <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .privacy {
    padding: 0 var(--gutter);
  }

  .privacy a {
    color: var(--accent-text);
  }
</style>
