---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { url } from '../utils/url';
---

<BaseLayout
  title="Privacy"
  description="Privacy information for this static portfolio: no analytics, no tracking, no personal data collected through the site itself."
>
  <section class="page-header">
    <h1 class="page-header__title">Privacy</h1>
  </section>

  <section class="privacy prose">
    <p>
      This site is static: it has no analytics or tracking tools, and it doesn't collect personal data
      through forms or accounts.
    </p>
    <p>
      Nothing is stored on your device except your theme choice. See the <a href={url('cookies/')}>Cookie Policy</a> for details.
    </p>
    <p>
      GitHub Pages, the hosting service for this site, may log visitors' IP addresses as part of its
      standard access logs. See <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener">GitHub's Privacy Statement</a> for details.
    </p>
    <p>
      The data controller is {site.name}, reachable at <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
    <p>
      If you write to me by email, I use your address and the content of your message only to reply,
      and I don't share them with anyone.
    </p>
    <p>
      Under the GDPR (Articles 15–22) you have the right to access, correct or delete your personal data,
      to restrict or object to its processing, and to data portability. To exercise these rights, write to
      the address above. You also have the right to lodge a complaint with the Italian Data Protection
      Authority (<a href="https://www.garanteprivacy.it" target="_blank" rel="noopener">Garante per la protezione dei dati personali</a>).
    </p>
    <p class="privacy__updated">Last updated: November 17, 2026</p>
  </section>
</BaseLayout>

<style>
  .privacy {
    padding: 0 var(--gutter);
  }

  .privacy a {
    color: var(--accent-text);
  }

  .privacy__updated {
    opacity: 0.7;
    font-size: 0.9em;
  }
</style>
