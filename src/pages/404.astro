---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../utils/url';
---

<BaseLayout title="Page not found" showFooterCta={false}>
  <section class="lost">
    <div class="orb lost__orb" aria-hidden="true"></div>
    <h1 class="lost__title">This page has set.</h1>
    <p class="lost__text">
      Like the moon at dawn, whatever was here is gone &mdash; or it never rose in the first place.
    </p>
    <a class="button" href={url()}>Back home <Arrow /></a>
  </section>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    padding: clamp(9rem, 18vw, 12rem) var(--gutter) 0;
    max-width: 44rem;
  }

  .lost__orb {
    --orb-size: 72px;
    --orb-blur: 40px;
    --orb-spread: 14px;

    margin-bottom: 1rem;
  }

  .lost__title {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
  }

  .lost__text {
    max-width: 44ch;
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }
</style>
