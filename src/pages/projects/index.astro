---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../data/projects';
import comingSoonSky from '../../assets/img/coming-soon-sky.png';
import '../../styles/projects.css';

const projects = await getProjects();

// Sfondo della card "More on the way": ottimizzato a parte e passato al CSS come variabile,
// come le copertine in ProjectCard.astro.
const soonSky = await getImage({ src: comingSoonSky, width: 1600, format: 'webp' });
---

<BaseLayout
  title="Projects"
  description="Projects by Alessio Pianaroli: full stack web apps, a tactical game and the design of this site."
>
  <section class="page-header">
    <h1 class="page-header__title">Projects</h1>
    <p class="page-header__sub">
      Things I've built, from web platforms to a game, each one drawn here in its own little scene.
      More are on the way.
    </p>
  </section>

  <section class="projects-list" aria-label="All projects">
    <ul class="card-grid">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} headingLevel="h2" />
          </li>
        ))
      }
      <li class="card card--soon" aria-label="New projects coming soon" style={`--soon-sky:url("${soonSky.src}")`}>
        <div class="card__body">
          <h2 class="card__title">More on the way</h2>
          <p class="card__meta">In progress</p>
        </div>
      </li>
    </ul>
  </section>
</BaseLayout>
