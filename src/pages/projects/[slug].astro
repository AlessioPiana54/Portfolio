---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { url } from '../../utils/url';
import '../../styles/projects.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { title, category, year, summary, cover, coverAlt, gallery, role, stack, links } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <article class="project">
    <a class="text-link project__back" href={url('projects/')}><Arrow direction="left" /> All projects</a>

    <header class="project__header">
      <h1 class="project__title">{title}</h1>
      <p class="project__meta">{category} &middot; {year}</p>
      <p class="project__summary">{summary}</p>

      {
        (role || stack.length > 0 || links.length > 0) && (
          <dl class="project__facts">
            {role && (
              <div class="project__fact">
                <dt>Role</dt>
                <dd>{role}</dd>
              </div>
            )}
            {stack.length > 0 && (
              <div class="project__fact">
                <dt>Stack</dt>
                <dd>
                  <ul class="project__stack">
                    {stack.map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
            {links.length > 0 && (
              <div class="project__fact">
                <dt>Links</dt>
                <dd class="project__links">
                  {links.map((link) => (
                    <a class="text-link" href={link.href} target="_blank" rel="noopener">
                      {link.label} <span aria-hidden="true">&#8599;</span>
                      <span class="visually-hidden">(opens in a new tab)</span>
                    </a>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        )
      }
    </header>

    <figure class="project__hero">
      <Image
        class="project__hero-img"
        src={cover}
        alt={coverAlt}
        widths={[640, 960, 1400]}
        sizes="(max-width: 960px) 100vw, 900px"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="project__body prose">
      <Content />
    </div>

    {
      gallery.length > 0 && (
        <div class="project__gallery">
          {gallery.map((item) => (
            <Image class="project__gallery-img" src={item.src} alt={item.alt} widths={[480, 960]} sizes="(max-width: 820px) 100vw, 440px" />
          ))}
        </div>
      )
    }

    {
      prev.id !== project.id && (
        <nav class="project__pager drawn-rule" aria-label="More projects">
          <a class="project__pager-link" href={url(`projects/${prev.id}/`)}>
            <span class="project__pager-label"><Arrow direction="left" /> Previous</span>
            <span class="project__pager-title">{prev.data.title}</span>
          </a>
          <a class="project__pager-link project__pager-link--next" href={url(`projects/${next.id}/`)}>
            <span class="project__pager-label">Next <Arrow /></span>
            <span class="project__pager-title">{next.data.title}</span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>
